generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  name          String
  gender        Gender
  lastName      String
  username      String    @unique @db.VarChar(255)
  email         String    @unique @db.VarChar(255)
  password      String
  age           Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  points        Int       @default(0)
  pfpUrl        String?   @default("")
  university    String?
  yearOfStudy   String?
  achievements  String[]  @default([])
  savedNotes    String[]  @default([])
  readLectures  Lecture[] @relation("ReadLectures")
  solvedQuizzes Quiz[]    @relation("SolvedQuizzes")
  savedPrograms Program[] @relation("userSavedPrograms")
}

model Quiz {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  question    String
  options     String[]
  answers     String[]
  level       String
  solvedBy    User[]   @relation("SolvedQuizzes")
}

model Lecture {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  content     String   // Changed from Bytes to String
  link        String?
  readBy      User[]   @relation("ReadLectures")
}

model Program {
  id        Int    @id @default(autoincrement())
  name      String
  content   String
  userId    Int
  user      User   @relation("userSavedPrograms", fields: [userId], references: [id])
}

enum Gender {
  MALE
  FEMALE
}
